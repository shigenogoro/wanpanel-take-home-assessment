# Copy to backend/.env

# SQLite (no server, no credentials, created on first run)
DATABASE_URL=sqlite:///./wanpanel.db

# Comma-separated origins allowed to call the API / open a WebSocket.
CORS_ORIGINS=http://localhost:3000

# --- Event rule tuning (all optional; defaults live in app/config.py) ---
# CONF_THRESHOLD=0.45
# DWELL_SECONDS=2.0
# HYSTERESIS_GRACE_SECONDS=0.5
# TRACK_COOLDOWN_SECONDS=15.0
# ZONE_COOLDOWN_SECONDS=10.0
# ABSENCE_SECONDS=10.0
